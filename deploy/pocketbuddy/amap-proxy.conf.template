# Generated privately during deployment. The security code substituted here
# must never be copied into the public release or committed to Git.
location /_AMapService/v4/map/styles {
    limit_req zone=pocketbuddy_maps burst=30 nodelay;
    limit_req_status 429;
    set $args "$args&jscode=__AMAP_SECURITY_JSCODE__";
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
    proxy_pass https://webapi.amap.com/v4/map/styles;
    access_log off;
    error_log /dev/null crit;
}
location /_AMapService/ {
    limit_req zone=pocketbuddy_maps burst=30 nodelay;
    limit_req_status 429;
    set $args "$args&jscode=__AMAP_SECURITY_JSCODE__";
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
    proxy_pass https://restapi.amap.com/;
    access_log off;
    error_log /dev/null crit;
}
