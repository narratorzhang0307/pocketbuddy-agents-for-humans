{
  "name": "pocketbuddy",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/narratorzhang0307/pocketbuddy.git"
  },
  "type": "module",
  "scripts": {
    "start": "npm run build:web && node server.mjs",
    "dev": "vite --config vite.pocketbuddy.config.ts",
    "build": "vite build --config vite.pocketbuddy.config.ts",
    "build:web": "node scripts/clean-generated.mjs --web && node deploy/pocketbuddy/build-coach-web.mjs && node node_modules/vite/bin/vite.js build --config vendor/her-motion/vite.config.ts && npm run build",
    "postbuild": "node scripts/ios/verify-frost-skills.mjs dist",
    "clean:generated": "node scripts/clean-generated.mjs",
    "clean:check": "node scripts/clean-generated.mjs --check",
    "mobile:sync": "npm run build && cap sync android",
    "ios:prepare": "node scripts/ios/prepare.mjs",
    "ios:check": "node scripts/hardware/check-bird-release.mjs --web-dir ios/App/App/public && node scripts/ios/check.mjs",
    "bird:check": "node scripts/hardware/check-bird-release.mjs --source-only",
    "ios:install": "node scripts/ios/install.mjs",
    "ios:test": "node --test scripts/ios/provenance.test.mjs scripts/ios/verify-app-icon.test.mjs",
    "hardware:check": "node scripts/hardware/verify-agent-link.mjs",
    "ios:open": "cap open ios",
    "agentic:check": "node scripts/agentic/verify-submission.mjs",
    "agentic:preflight": "node scripts/agentic/preflight-cloud.mjs",
    "preview": "npm run build:web && vite preview --config vite.pocketbuddy.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "health:install-connectors": "node scripts/health/install-connectors.mjs",
    "health:verify-connectors": "node scripts/health/install-connectors.mjs --verify-only",
    "health:eval-qwen4b-skills": "vitest run scripts/health/qwen4b-skill-chain.live.test.ts --reporter=verbose"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capgo/capacitor-photo-library": "8.0.23",
    "@google-cloud/firestore": "9.0.0",
    "@google/genai": "2.19.0",
    "@huggingface/transformers": "4.2.0",
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "@mlc-ai/web-llm": "0.2.84",
    "@paddleocr/paddleocr-js": "0.4.2",
    "clsx": "2.1.1",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "html2canvas": "1.4.1",
    "jszip": "3.10.1",
    "lucide-react": "0.487.0",
    "mapbox-gl": "3.29.0",
    "motion": "13.1.1",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.5",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
