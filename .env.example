# Copy this file to .env.local. Never commit .env.local or real credentials.

# Optional local integration. Keep machine-specific paths in .env.local only.
# SOUND_WALK_ROOT=/absolute/path/to/shengsheng-soundwalk
# POCKET_EARTH_PUBLIC_ROOT=/absolute/path/to/pocket-earth/public

# --- AMap / 高德地图 ---
VITE_MAP_PROVIDER=amap
VITE_AMAP_KEY=your_amap_web_jsapi_key_here
# Local development only. For production use VITE_AMAP_SERVICE_HOST instead.
VITE_AMAP_SECURITY_JSCODE=your_amap_security_jscode_here
# VITE_AMAP_SERVICE_HOST=https://api.example.com/_AMapService
VITE_AMAP_STYLE=amap://styles/dark

# --- Skill Taskmaster / pocketbuddy-api ---
# Local `npm run dev` starts the API on 8787 and Vite proxies /v1 to it.
POCKETBUDDY_API_DEV_URL=http://127.0.0.1:8787
VITE_POCKETBUDDY_DEV_TOKEN=pocketbuddy-local-dev
# Production frontend may set a same-origin rewrite and leave this empty.
# VITE_POCKETBUDDY_API_BASE=https://api.example.com
# Server-only Gemma upstream credentials. Use Secret Manager on Cloud Run.
GEMMA_BASE_URL=
GEMMA_API_TOKEN=
GEMMA_MODEL=gemma-3-4b-pocketbuddy

# --- Qwen through the local/production server ---
# Server-only: never add a VITE_ prefix to this key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
QWEN_MODEL_ROUTE=qwen3.7-max
QWEN_MODEL_TASKMASTER=qwen3.7-max
QWEN_MODEL_MULTILINGUAL=qwen3.7-max
QWEN_PET_IMAGE_MODEL=qwen-image-2.0-pro

# --- Qwen/MNN edge runtime ---
EDGE_BACKEND=auto
MNN_URL=http://127.0.0.1:8000
EDGE_MODEL=qwen3:4b
EDGE_VISION_MODEL=qwen3-vl:4b

# --- Health Skill bridge ---
# Keep disabled on a public server unless authentication is added.
HEALTH_SKILL_LOCAL_BRIDGE=false
# HEALTHSYNC_BIN=/absolute/path/to/healthsync
# GARMIN_CONNECT_BIN=/absolute/path/to/garmin-connect

# Optional local companion runtimes.
VITE_LIANLEMA_URL=http://localhost:8082/
