# Copy this file to .env.local. Never commit .env.local or real credentials.

# --- AMap / 高德地图 ---
VITE_MAP_PROVIDER=amap
VITE_AMAP_KEY=your_amap_web_jsapi_key_here
# Local development only. For production use VITE_AMAP_SERVICE_HOST instead.
VITE_AMAP_SECURITY_JSCODE=your_amap_security_jscode_here
# VITE_AMAP_SERVICE_HOST=https://api.example.com/_AMapService
VITE_AMAP_STYLE=amap://styles/dark

# --- Qwen through the local/production server ---
# Server-only: never add a VITE_ prefix to this key.
DASHSCOPE_API_KEY=
# MiniMax TTS only; no ASR endpoint is configured by this integration.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=male-qn-qingse
# Production voice proxy access code, >=32 characters, different from the provider API key.
# Never use a VITE_ prefix or bundle either secret into an APK/IPA.
FROST_VOICE_ACCESS_TOKEN=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
QWEN_MODEL_ROUTE=qwen3.7-max
QWEN_MODEL_TASKMASTER=qwen3.7-max
QWEN_MODEL_SUBAGENT=qwen3.8-max
QWEN_MODEL_MULTILINGUAL=qwen3.7-max
QWEN_PET_IMAGE_MODEL=qwen-image-2.0-pro

# --- Qwen/MNN edge runtime ---
EDGE_BACKEND=auto
MNN_URL=http://127.0.0.1:8000
EDGE_MODEL=qwen3:4b
EDGE_VISION_MODEL=qwen3-vl:4b

# --- Health Skill bridge ---
# Keep disabled on a public server unless authentication is added.
HEALTH_SKILL_LOCAL_BRIDGE=false
# HEALTHSYNC_BIN=/absolute/path/to/healthsync
# GARMIN_CONNECT_BIN=/absolute/path/to/garmin-connect

# --- Hospital / Doctor sub-agent (server-only) ---
# The friend's deployed DOCTOR Agent root URL, NOT the contest SERVICE_BASE_URL.
# Empty means not connected; never assume localhost or a chat endpoint exists.
HOSPITAL_AGENT_BASE_URL=
# Optional Bearer token for the deployment gateway (not the contest service token).
# Remote authenticated connections require HTTPS. Never prefix these with VITE_.
HOSPITAL_AGENT_API_TOKEN=
# Qwen-backed human consultation trial (separate from the original contest runner).
# Dedicated >=32-character access token; kept server-side and entered at trial setup,
# never compiled into a mobile app. Empty disables the consultation API.
HOSPITAL_CHAT_ACCESS_TOKEN=
# Optional; otherwise uses the existing QWEN_MODEL.
# HOSPITAL_QWEN_MODEL=qwen3.7-max

# Optional desktop companion runtime. localhost only works on the Mac itself.
# iOS/Android or remote browsers need a reachable HTTPS coach + model service;
# USB pairing does not forward the Mac's localhost. This setting does not bundle models.
VITE_LIANLEMA_URL=http://localhost:8082/

# iOS bundled app API origin. Public address only; no provider keys here.
# Leave unset to use the new Pocket Buddy host. Deploy server.mjs + ios-api-cors.mjs
# there before cloud testing; this setting does NOT deploy or switch the web app.
# VITE_POCKET_BUDDY_API_ORIGIN=https://pocketbuddy.throughtheglass.art
